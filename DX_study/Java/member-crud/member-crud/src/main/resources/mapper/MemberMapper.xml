<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.membercrud.mapper.MemberMapper">

    <!-- DB 컬럼과 Java 필드의 대응 관계를 눈으로 확인하기 위한 resultMap -->
    <resultMap id="memberResultMap" type="com.example.membercrud.domain.Member">
        <id property="memberId" column="MEMBER_ID"/>
        <result property="email" column="EMAIL"/>
        <result property="name" column="NAME"/>
        <result property="phone" column="PHONE"/>
        <result property="createdAt" column="CREATED_AT"/>
    </resultMap>

    <select id="findAll" resultMap="memberResultMap">
        SELECT MEMBER_ID, EMAIL, NAME, PHONE, CREATED_AT
        FROM MEMBERS
        ORDER BY MEMBER_ID
    </select>

    <select id="findById" parameterType="long" resultMap="memberResultMap">
        SELECT MEMBER_ID, EMAIL, NAME, PHONE, CREATED_AT
        FROM MEMBERS
        WHERE MEMBER_ID = #{memberId}
    </select>

    <insert id="insert" parameterType="com.example.membercrud.domain.Member">
        <selectKey keyProperty="memberId" resultType="long" order="BEFORE">
            SELECT MEMBERS_SEQ.NEXTVAL FROM DUAL
        </selectKey>
        INSERT INTO MEMBERS (MEMBER_ID, EMAIL, NAME, PHONE, CREATED_AT)
        VALUES (#{memberId}, #{email}, #{name}, #{phone}, SYSTIMESTAMP)
    </insert>

    <update id="update" parameterType="com.example.membercrud.domain.Member">
        UPDATE MEMBERS
        SET EMAIL = #{email},
            NAME = #{name},
            PHONE = #{phone}
        WHERE MEMBER_ID = #{memberId}
    </update>

    <delete id="deleteById" parameterType="long">
        DELETE FROM MEMBERS
        WHERE MEMBER_ID = #{memberId}
    </delete>
</mapper>

